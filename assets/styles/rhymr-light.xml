<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rhymr-light" name="Rhymr Light" version="1.0">
  <author>Rhymr Team</author>
  <description>Classic IntelliJ-style light theme for poetry writing</description>

  <!-- Main styles -->
  <style name="text" foreground="#000000" background="#ffffff"/>
  <style name="selection" background="#a6d2ff" foreground="#000000"/>
  <style name="selection-unfocused" background="#d4d4d4" foreground="#000000"/>
  <style name="cursor" foreground="#000000"/>
  <style name="secondary-cursor" foreground="#000000"/>
  <style name="line-numbers" foreground="#999999" background="#f0f0f0"/>
  <style name="line-numbers-border" background="#d0d0d0"/>
  <style name="bracket-match" background="#93d9d9" bold="true"/>
  <style name="bracket-mismatch" background="#ffcccc" bold="true"/>
  <style name="right-margin" foreground="#ced0d6" background="#ffffff"/>
  <style name="draw-spaces" foreground="#a8a8a8"/>
  <style name="background-pattern" background="#ffffff"/>

  <!-- Editor specific -->
  <style name="rhyme-editor-gutter" foreground="#999999" background="#f0f0f0"/>
  <style name="syllable-count" foreground="#3a8a2e" background="#f0f0f0"/>

  <!-- Current line highlight — classic pale-yellow -->
  <style name="line-highlight" background="#fcfaed"/>
  <style name="current-line-number" foreground="#000000" background="#fcfaed" bold="true"/>
  <style name="current-line" background="#fcfaed"/>

  <!-- JSON syntax (issue #26). Only .json files get a GtkSourceView
       language; json.lang maps its contexts onto these def:* styles.
       Colours follow classic IntelliJ Light. -->
  <style name="def:constant"         foreground="#660e7a"/>
  <style name="def:string"           foreground="#008000"/>
  <style name="def:special-char"     foreground="#000080" bold="true"/>
  <style name="def:decimal"          foreground="#0000ff"/>
  <style name="def:floating-point"   foreground="#0000ff"/>
  <style name="def:boolean"          foreground="#000080" bold="true"/>
  <style name="def:special-constant" foreground="#000080" bold="true"/>
  <style name="def:error"            foreground="#ff0000" bold="true"/>

</style-scheme>

<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rhymr-light" name="Rhymr Light" version="1.0">
  <author>Rhymr Team</author>
  <description>Light theme optimized for poetry writing</description>

  <!-- Main styles -->
  <style name="text" foreground="#2b2b2b" background="#ffffff"/>
  <style name="selection" background="#3a6ea5" foreground="#ffffff"/>
  <style name="selection-unfocused" background="#4a80b8" foreground="#ffffff"/>
  <style name="cursor" foreground="#1a1a1a"/>
  <style name="secondary-cursor" foreground="#2b2b2b"/>
  <style name="line-numbers" foreground="#9a9a9a" background="#ececec"/>
  <style name="line-numbers-border" background="#d0d0d0"/>
  <style name="bracket-match" background="#4a80b8" bold="true"/>
  <style name="bracket-mismatch" background="#f0f0f0" bold="true"/>
  <style name="right-margin" foreground="#d0d0d0" background="#f3f3f3"/>
  <style name="draw-spaces" foreground="#767676"/>
  <style name="background-pattern" background="#f3f3f3"/>

  <!-- Editor specific -->
  <style name="rhyme-editor-gutter" foreground="#767676" background="#ececec"/>
  <style name="syllable-count" foreground="#767676" background="#ececec"/>

  <!-- Current line highlight -->
  <style name="line-highlight" background="#3a6ea533"/>
  <style name="current-line-number" foreground="#1a1a1a" background="#3a6ea533" bold="true"/>
  <style name="current-line" background="#3a6ea533"/>

</style-scheme>
